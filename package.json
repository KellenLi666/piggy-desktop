{
  "name": "piggy-desktop",
  "version": "1.1.1",
  "private": true,
  "description": "Piggy 独立桌面宠物 · DeepSeek 聊天助手",
  "author": "KellenLi666",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "package:dir": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.piggy.desktop",
    "productName": "Piggy",
    "executableName": "Piggy",
    "asar": true,
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/piggy.ico",
      "signAndEditExecutable": false
    },
    "electronDist": "node_modules/electron/dist"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/KellenLi666/piggy-desktop.git"
  },
  "homepage": "https://github.com/KellenLi666/piggy-desktop",
  "bugs": {
    "url": "https://github.com/KellenLi666/piggy-desktop/issues"
  }
}
